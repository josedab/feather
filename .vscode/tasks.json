{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test Quick",
      "type": "shell",
      "command": "make test-quick",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test One",
      "type": "shell",
      "command": "make test-one RUN=${input:testName}",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Lint Fix",
      "type": "shell",
      "command": "make lint-fix",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run Dev",
      "type": "shell",
      "command": "make run-dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Smoke Test",
      "type": "shell",
      "command": "make smoke-test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test function name (e.g., TestFeatureStore)"
    }
  ]
}
