# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.{yaml,yml,json,js,ts,tsx,jsx,css,html,md,mdx}]
indent_style = space
indent_size = 2

[*.proto]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2
