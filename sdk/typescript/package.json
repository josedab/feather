{
  "name": "@feather/client",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript client for Feather Feature Store",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "feather",
    "feature-store",
    "ml",
    "machine-learning",
    "features",
    "vector-search"
  ],
  "author": "Feather Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/feather-store/feather"
  },
  "bugs": {
    "url": "https://github.com/feather-store/feather/issues"
  },
  "homepage": "https://github.com/feather-store/feather#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
